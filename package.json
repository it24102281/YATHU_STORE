{
  "name": "yathu-pubg-store",
  "version": "1.0.0",
  "description": "Complete MERN stack website for YATHU PUBG STORE - PUBG account selling business",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "node scripts/start-client.js",
    "build": "cd client && npm run build",
    "start": "node scripts/start-root.js",
    "start:server": "cd server && npm start"
  },
  "keywords": [
    "MERN",
    "PUBG",
    "gaming",
    "ecommerce",
    "react",
    "node",
    "mongodb"
  ],
  "author": "YATHU PUBG STORE",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
