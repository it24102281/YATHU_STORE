# Database Configuration
MONGODB_URI=mongodb://localhost:27017/yathu-pubg-store

# Email Configuration (Either SMTP or HTTP API keys are required)
# -------------------------------------------------------------
# Option A: HTTP Email API (Recommended for Render/Vercel)
# Sign up at brevo.com, sendgrid.com, or resend.com
BREVO_API_KEY=your-brevo-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
RESEND_API_KEY=your-resend-api-key

# Option B: Standard SMTP Configuration (Might timeout on Render Free Tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yathupubg@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_SECURE=true
EMAIL_FROM=YATHU PUBG STORE <yathupubg@gmail.com>

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL
CLIENT_URL=http://localhost:3000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Reseller API Integration
CID_API_URL=https://cidgrowthmedia.com/api/v2
CID_API_KEY=your-cidgrowthmedia-api-key
INR_TO_LKR_RATE=3.65
PRICE_MARKUP_PERCENT=0
RESELLER_API_BASE_URL=https://cidgrowthmedia.com/api/v2
RESELLER_API_KEY=your-cidgrowthmedia-api-key
RESELLER_API_MODE=smm_panel

# Admin Credentials (default)
ADMIN_EMAIL=admin@yathupubg.com
ADMIN_PASSWORD=admin123
